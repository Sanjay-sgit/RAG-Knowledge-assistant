# Copy this file to .env and fill in your key:  copy .env.example .env   (Windows)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional second (third, ...) key for automatic failover: if a model's free-tier
# DAILY quota runs out on key1, the app automatically switches to key2 and keeps
# going instead of failing every call until the quota resets at midnight Pacific.
# Each key should be its own separate Google account / AI Studio project so it has
# its own independent quota. Not required - the app works fine with just key1.
# key2=
# key3=

# --- Models (defaults shown) ---
# Deliberately different models per role, so each draws from its OWN free-tier quota -
# if one model's daily limit runs out, only that role is affected, not the whole app.
# See https://aistudio.google.com/rate-limit for your account's live usage per model.
# CHAT_MODEL=gemini-2.5-flash          # final answer the user reads
# UTILITY_MODEL=gemini-3.5-flash-lite  # query rewrite + rerank (called more often, needs less capability)
# JUDGE_MODEL=gemini-2.5-flash         # LLM-as-a-judge scoring in evaluation/eval.py (defaults to CHAT_MODEL)
# EMBEDDING_MODEL=gemini-embedding-2
#
# Google retires/renames free Gemini models fairly often. If a role starts throwing
# "404 NOT_FOUND ... model is no longer available", the error message itself names the
# replacement model - just set that role's env var above (or in your real .env) and restart.
# No code changes needed for a model rename.

# --- Retrieval ---
# RETRIEVAL_K=20
# FINAL_K=10
# USE_QUERY_REWRITE=true   # set false to skip a call and use the raw question
# USE_RERANK=true          # set false to skip a call and use retrieval order as-is
# MAX_RETRIES=5
# OPEN_BROWSER=true
# GRADIO_SERVER_PORT=7860

# --- Free-tier safety (defaults are already tuned for the free tier) ---
# GEMINI_RPM=10           # per-minute cap PER MODEL - keep under Google's free-tier ~15/min
# INGEST_WORKERS=1        # parallel ingest workers - each draws from the same quota
# EVAL_SAMPLE_SIZE=0      # 0 = evaluate all 150 test questions; try 10 for a quick dashboard demo
