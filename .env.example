# Copy this file to .env and fill in your key:  copy .env.example .env   (Windows)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional second (third, ...) key for automatic failover: if a model's free-tier
# DAILY quota runs out on key1, the app automatically switches to key2 and keeps
# going instead of failing every call until the quota resets at midnight Pacific.
# Each key should be its own separate Google account / AI Studio project so it has
# its own independent quota. Not required - the app works fine with just key1.
# key2=
# key3=

# --- Models (defaults shown) ---
# Deliberately different models per role, so each draws from its OWN free-tier quota -
# if one model's daily limit runs out, only that role is affected, not the whole app.
# See https://aistudio.google.com/rate-limit for your account's live usage per model.
# CHAT_MODEL=gemini-2.5-flash          # final answer the user reads
# UTILITY_MODEL=gemini-3.5-flash-lite  # rerank (+ query rewrite unless REWRITE_MODEL is set)
# REWRITE_MODEL=                       # query rewrite only; a Gemma model (high daily quota) fits well.
#                                      # Copy the exact model id from AI Studio. Empty = use UTILITY_MODEL.
# JUDGE_MODEL=gemini-2.5-flash         # LLM-as-a-judge scoring in evaluation/eval.py (defaults to CHAT_MODEL)
#
# Judge on Groq instead (different model family = not graded by the model that wrote the answer,
# and a separate quota from Gemini). A non-gemini JUDGE_MODEL switches to Groq automatically.
# JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=                        # also accepted as judge_key; get one at https://console.groq.com/keys
# JUDGE_PROVIDER=                      # gemini / groq; empty = auto from JUDGE_MODEL
# GROQ_RPM=5                           # judge calls per minute (~1.5K tokens each vs Groq's 8K tokens/min)
# GROQ_MAX_TOKENS=1024                 # cap on reasoning + reply tokens per judge call
# GROQ_REASONING_EFFORT=low            # gpt-oss thinking effort: low / medium / high
# EMBEDDING_MODEL=gemini-embedding-2
#
# Google retires/renames free Gemini models fairly often. If a role starts throwing
# "404 NOT_FOUND ... model is no longer available", the error message itself names the
# replacement model - just set that role's env var above (or in your real .env) and restart.
# No code changes needed for a model rename.

# --- Retrieval ---
# RETRIEVAL_K=20
# FINAL_K=10
# USE_QUERY_REWRITE=true   # set false to skip a call and use the raw question
# USE_RERANK=true          # set false to skip a call and use retrieval order as-is
# MAX_RETRIES=5
# OPEN_BROWSER=true
# GRADIO_SERVER_PORT=7860

# --- Free-tier safety (defaults are already tuned for the free tier) ---
# GEMINI_RPM=10           # per-minute cap PER MODEL - keep under Google's free-tier ~15/min
# INGEST_WORKERS=1        # parallel ingest workers - each draws from the same quota
# EVAL_SAMPLE_SIZE=0      # 0 = evaluate all 150 test questions; try 10 for a quick dashboard demo
# EVAL_WORKERS=2         # questions evaluated at once (the per-model rate limiter still caps RPM)
# EVAL_LIVE_SAMPLE=5     # live-check size selected by default in the /evaluation dropdown
# EVAL_LIVE_MAX=10       # largest live-check size on the PUBLIC page (the chat waits while it runs);
#                        # the local dashboard (python evaluator.py) offers 5 ... 150
# EVAL_RESULTS_PATH=     # where `python -m evaluation.run` saves results (default evaluation/results.json)
# GEMINI_HTTP_TIMEOUT_S=30 # per Gemini HTTP call; stops a stalled connection from hanging the app

# --- Public demo limits (used by app.py; matter once the app has a public URL) ---
# MAX_QUESTION_CHARS=500         # longer questions are rejected
# MAX_HISTORY_MESSAGE_CHARS=1500 # earlier chat messages are trimmed to this length
# DAILY_QUESTION_LIMIT=150       # questions per day for the whole site (midnight UTC reset); 0 = no limit
# QUEUE_MAX_SIZE=20              # visitors that can wait in line; the rest are asked to retry
# PORT=                          # set automatically by Render; makes the app listen on 0.0.0.0:$PORT

# --- LangChain baseline only (implementation/) ---
# OPENROUTER_API_KEY=
